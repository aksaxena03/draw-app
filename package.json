{
  "name": "draw-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate":"cd packages/db && pnpm add @prisma/client@5.13.0 && npx prisma generate && cd ../..",
    "start:web":"cd apps/client && pnpm run start",
    "start:http-server":"cd apps/http-server && node ./dist/index.js",
    "start:ws-server":"cd apps/ws-server && node ./dist/index.js"

    
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prisma": "^5.13.0",
    "turbo": "^2.5.4",
    "typescript": "5.8.2"
  },
  "type": "module",
  
  
  "packageManager": "pnpm@9.15.9"

}
