{
  "name": "draw-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --dir packages/db run db:generate",
    "start:client_fe": "cd apps/client_fe && pnpm run start",
    "start:http-server": "cd apps/http-server && node ./dist/index.js",
    "start:ws-server": "cd apps/ws-server && node ./dist/index.js"
    ,"start":"concurrently -n http-server,client_fe,ws-server -c green,red,blue \" pnpm run start:client_fe \" \"pnpm run start:http-server \" \"pnpm run start:ws-server \""
    
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prisma": "^6.16.1",
    "turbo": "^2.5.4",
    "typescript": "5.8.2"
  },
  "type": "module",
  
  
  "packageManager": "pnpm@9.15.9"

}
