{
  "name": "@repo/db",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/db.js",
  "types": "./dist/db.d.ts",
  "exports": {
    "./client": "./dist/db.js"
  },
  "scripts": {
    "build": "pnpm db:generate && tsc -b && pnpm copy-prisma",
    "copy-prisma": "xcopy src\\generated dist\\generated /E /I /Y >nul 2>nul || cp -r src/generated dist/generated || :",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate"
  },
  "devDependencies": {
    "prisma": "^5.13.0",
    "typescript": "^5.8.2"
  },
  "keywords": [],
