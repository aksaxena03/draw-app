FROM node:18-alpine

RUN corepack enable

WORKDIR /user/src/app


COPY ./pnpm-lock.yaml ./pnpm-lock.yaml


COPY ./package ./package

COPY ./package.json ./package.json

COPY ./pnpm-lock.yaml ./pnpm-lock.yaml

COPY ./turbo.json ./turbo.json

COPY ./apps/client_fe ./apps/client_fe


RUN pnpm run install
RUN pnpm run build

COPY . .

CMD [ "pnpm " ,"start" ]
