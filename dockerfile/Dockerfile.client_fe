FROM node:18-alpine

RUN corepack enable

WORKDIR /usr/src/app

# Copy workspace manifests
COPY package.json pnpm-lock.yaml ./
COPY pnpm-workspace.yaml ./
COPY turbo.json ./

# Copy client package manifest and source
COPY apps/client_fe/package.json ./apps/client_fe/package.json
COPY apps/client_fe ./apps/client_fe

# Install only client dependencies and build client
RUN pnpm install --filter ./apps/client_fe...
RUN pnpm --filter ./apps/client_fe... run build

# Run the Next.js server
WORKDIR /usr/src/app/apps/client_fe

EXPOSE 3000

CMD ["pnpm", "start:client_fe"]
