FROM node:18-alpine

# Enable corepack and install turbo globally
RUN corepack enable

WORKDIR /usr/src/app

# Only copy the client app to avoid monorepo workspace complexity
COPY apps/client_fe/package.json ./package.json
COPY apps/client_fe/pnpm-lock.yaml ./pnpm-lock.yaml

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy the rest of the app source
COPY apps/client_fe .

# Build the application
RUN pnpm run build

EXPOSE 3000

CMD ["pnpm", "start"]
