FROM node:18-alpine

WORKDIR /usr/src/app

# Copy only the client app manifests first for better caching
COPY apps/client_fe/package.json ./package.json
COPY apps/client_fe/package-lock.json ./package-lock.json

# Install dependencies using npm lockfile
RUN npm ci

# Copy the rest of the app source
COPY apps/client_fe .

# Build the application
RUN npm run build

EXPOSE 3000

CMD ["pnpm", "start:client_fe"]
