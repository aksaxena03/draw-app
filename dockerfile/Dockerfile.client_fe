FROM node:18-bullseye-slim

RUN corepack enable

WORKDIR /usr/src/app

# Copy all package.json files first
COPY package.json pnpm-lock.yaml ./
COPY turbo.json ./
COPY apps/client_fe/package.json ./apps/client_fe/

# Copy pnpm workspace config
COPY pnpm-workspace.yaml ./

# Copy source files first
COPY apps/client_fe ./apps/client_fe

# Install all dependencies
RUN pnpm install --no-frozen-lockfile

# Build packages in order
WORKDIR /usr/src/app

# Build client_fe (dependencies already installed)
WORKDIR /usr/src/app/apps/client_fe
RUN pnpm run build

WORKDIR /usr/src/app

EXPOSE 3000

CMD ["pnpm", "run", "start:client_fe"]
