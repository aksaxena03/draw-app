FROM node:18-alpine

RUN corepack enable

WORKDIR /user/src/app


COPY ./pnpm-lock.yaml ./pnpm-lock.yaml


COPY ./packages ./packages

COPY ./package.json ./package.json

COPY ./pnpm-lock.yaml ./pnpm-lock.yaml

COPY ./turbo.json ./turbo.json

COPY ./apps/client_fe ./apps/client_fe


RUN pnpm install --filter client_fe
RUN pnpm run build --filter=client_fe

COPY . .

CMD [ "pnpm " ,"start","client_fe" ]
