FROM node:18-alpine

RUN corepack enable

WORKDIR /user/src/app

# Copy all package.json files first
COPY package.json pnpm-lock.yaml ./
COPY turbo.json ./
COPY packages/db/package.json ./packages/db/
COPY packages/backend-comman/package.json ./packages/backend-comman/
COPY packages/common/package.json ./packages/common/
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY apps/http-server/package.json ./apps/http-server/

# Copy pnpm workspace config
COPY pnpm-workspace.yaml ./

# Install all dependencies
RUN pnpm install

# Copy source files
COPY packages/db ./packages/db
COPY packages/backend-comman ./packages/backend-comman
COPY packages/common ./packages/common
COPY packages/typescript-config ./packages/typescript-config
COPY apps/http-server ./apps/http-server

# Generate Prisma client
WORKDIR /user/src/app/packages/db
RUN npx prisma generate
RUN pwd
# Build the application
WORKDIR /user/src/app

# Build dependencies first
RUN cd packages/backend-comman && pnpm run build
RUN cd packages/common && pnpm run build
RUN cd packages/db && pnpm run build

# Build the http-server
RUN cd apps/http-server && pnpm run build

CMD ["pnpm", "start:http-server"]
